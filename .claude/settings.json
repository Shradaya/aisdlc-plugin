{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "Edit(tasks/**)",
      "Edit(./tasks/**)",
      "Bash(node *aisdlc-state.js *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * push*)",
      "Bash(git -C * stash*)",
      "Bash(git -C * checkout*)",
      "Bash(git -C * switch*)",
      "Bash(git -C * pull*)",
      "Bash(git -C * fetch*)",
      "Bash(rm *)",
      "Bash(git rebase*)",
      "Bash(git -C * rebase*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(/tasks/*/task.yaml)",
      "Edit(tasks/*/task.yaml)",
      "Edit(./tasks/*/task.yaml)",
      "Edit(./secrets/**)",
      "Edit(./credentials/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git filter-branch*)",
      "Bash(git commit * --amend*)",
      "Bash(git -C * commit * --amend*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git -C * commit * --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  }
}
