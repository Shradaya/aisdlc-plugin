export default defineConfig({
  markdown: {
    config(md) {
      // ```mermaid blocks render as diagrams (client side); the source is passed base64-encoded
      const fence = md.renderer.rules.fence!;
      md.renderer.rules.fence = (tokens, idx, options, env, self) => {
        const token = tokens[idx];
        if (token.info.trim() === "mermaid") {
          return `<Mermaid code="${Buffer.from(unescape(encodeURIComponent(token.content)), "binary").toString("base64")}" />`;
        }
        return fence(tokens, idx, options, env, self);
      };
    },
  },
  title: "aisdlc",
  description:
    "How to use aisdlc, and a read-only browser for the repository knowledge it maintains.",
  srcDir: "docs",
  cleanUrls: true,
  lastUpdated: false,
  // Copied repository documents may contain relative links that only make sense in their original
  // location. Generated pages are exempt from dead-link checking; the hand-written guide is not.
  ignoreDeadLinks: [
    (_link: string, source: string) => /^(repos|system)\//.test(source),
  ],
  themeConfig: {
    nav: generated.nav.length
      ? generated.nav
      : [{ text: "Guide", link: "/guide/" }],
    sidebar: {
      "/guide/": guideSidebar,
      ...generated.sidebar,
    },
    search: { provider: "local" },
    outline: [2, 3],
    docFooter: { prev: "Previous", next: "Next" },
    footer: {
      message:
        "Read-only view. All changes are made through the aisdlc workflow in Claude Code.",
    },
  },
});
