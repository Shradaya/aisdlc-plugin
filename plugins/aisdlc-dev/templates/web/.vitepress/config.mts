import { defineConfig } from "vitepress";
import fs from "node:fs";
import path from "node:path";

// Generated by scripts/sync.mjs from what actually exists in the workspace (repos, system knowledge).
interface Generated {
  nav: any[];
  sidebar: Record<string, any[]>;
}
let generated: Generated = { nav: [], sidebar: {} };
try {
  generated = JSON.parse(
    fs.readFileSync(
      path.resolve(process.cwd(), ".vitepress/generated-nav.json"),
      "utf8",
    ),
  );
} catch {
  // sync has not run yet; the static guide still works.
}

const guideSidebar = [
  {
    text: "Start here",
    items: [
      { text: "What is aisdlc", link: "/guide/" },
      { text: "Getting started", link: "/guide/getting-started" },
      { text: "Command catalog", link: "/guide/commands" },
    ],
  },
  {
    text: "Lifecycles",
    items: [
      { text: "Feature lifecycle", link: "/guide/feature-lifecycle" },
      { text: "Bug lifecycle", link: "/guide/bug-lifecycle" },
      { text: "Approval gates", link: "/guide/approvals" },
    ],
  },
  {
    text: "When things go sideways",
    items: [
      { text: "When Jira is unavailable", link: "/guide/jira-unavailable" },
      { text: "Being blocked", link: "/guide/blocked" },
      { text: "Resume", link: "/guide/resume" },
