# Per-developer local settings (paths only / secrets)
.env
.env.*
claude.env
logs/audit.jsonl
node_modules/

# Local MCP server config, if you add one (machine-specific; Jira does not need it)
.mcp.json

# Claude Code per-developer local overrides (shared config lives in .claude/settings.json)
.claude/settings.local.json

# Runtime task state generated by the aisdlc lifecycle commands (keep the folder, not its contents)
tasks/*
!tasks/.gitkeep

# Runtime audit logs (keep the folder via .gitkeep)
logs/*.jsonl

# OS / editor cruft
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
