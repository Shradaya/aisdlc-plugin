# Copy to claude.env and adjust. Paths and settings only, never secrets (Claude can read this file).
# Dev: the folder holding all your repository clones (see config/repositories.yaml).
AISDLC_REPOS_ROOT=C:/path/to/folder/holding/all/clones
# AISDLC_REPO_REST_API_EVOKE=D:/elsewhere/rest-api-evoke

# QA: default target environment (a key of config/environments.yaml). Never production.
# QA_ENV=qa
# QA: watch-mode slow motion per browser action, in milliseconds.
# QA_SLOWMO=500

# Credentials never go in this file. Set them as environment variables, or in .env (gitignored, Claude is denied access):
#   JIRA_EMAIL, JIRA_API_TOKEN, BITBUCKET_API_TOKEN   Jira and Bitbucket (see the README for token scopes)
#   QA_USERNAME, QA_PASSWORD                          QA test account for the target environment
#   NODE_EXTRA_CA_CERTS                               behind Cloudflare WARP / Zscaler: path to the corporate root certificate
